rules_version = '2';

// 사용자당 문서 1개: users/{uid} = {
//   items: { "fe-1": { level, starred, memo, memoAt } },
//   memoRepo: { id, fullName }
// }
// 개인용 서비스라 소유자 GitHub 계정만 읽고 쓸 수 있다. 다른 계정은 로그인해도 거부되어 무료 한도를 쓸 수 없다.
// 본인 문서만 읽고 쓸 수 있고, 목록 조회(list)와 삭제는 막는다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 허용할 GitHub 사용자 번호 (https://api.github.com/users/<아이디> 의 id). 175471172 = YeongGyu1110
    function ownerGithubIds() {
      return ['175471172'];
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.identities['github.com'].hasAny(ownerGithubIds());
    }

    match /users/{uid} {
      allow get: if isOwner() && request.auth.uid == uid;
      allow create, update: if isOwner()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'memoRepo'])
        && (!('items' in request.resource.data) || request.resource.data.items is map)
        && (!('memoRepo' in request.resource.data) || request.resource.data.memoRepo is map);
    }
  }
}
